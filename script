    table.insert(trailConnections, player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if wig.Trails:Get() then applyTrail(player) end
    end))
    local function hookBackpack(backpack)
        table.insert(trailConnections, backpack.ChildAdded:Connect(function()
            if wig.Trails:Get() then applyTrail(player) end
        end))
        table.insert(trailConnections, backpack.ChildRemoved:Connect(function()
            if wig.Trails:Get() then applyTrail(player) end
        end))
    end
    if player:FindFirstChild("Backpack") then
        hookBackpack(player.Backpack)
    end
    table.insert(trailConnections, player.ChildAdded:Connect(function(child)
        if child.Name == "Backpack" then hookBackpack(child) end
    end))
end

