local function getEnvironments()
    local list = {}
    if type(getgenv) == "function" then
        local ok, env = pcall(getgenv)
        if ok and type(env) == "table" then table.insert(list, env) end
    end
    if type(getfenv) == "function" then
        local ok, env = pcall(getfenv, 0)
        if ok and type(env) == "table" then table.insert(list, env) end
    end
    table.insert(list, _G)
    return list
end

local SavedToggleState = {}
local function loadToggleState()
    for _, env in ipairs(getEnvironments()) do
        if type(env.readfile) == "function" and type(env.isfile) == "function" then
            local existsOK, exists = pcall(env.isfile, TOGGLE_STATE_FILE)
            if existsOK and exists then
                local readOK, contents = pcall(env.readfile, TOGGLE_STATE_FILE)
                if readOK and type(contents) == "string" then
                    local decodeOK, decoded = pcall(function() return HttpService:JSONDecode(contents) end)
                    if decodeOK and type(decoded) == "table" then
                        SavedToggleState = decoded
                        return
                    end
                end
            end
        end
        if type(env.OnrushaAutoFarmState) == "table" then
            SavedToggleState = table.clone(env.OnrushaAutoFarmState)
            return
        end
    end
end

loadToggleState()

local function saveToggleState()
    for _, env in ipairs(getEnvironments()) do
        if type(env.writefile) == "function" then
            pcall(env.writefile, TOGGLE_STATE_FILE, HttpService:JSONEncode(SavedToggleState))
        end
        pcall(function() env.OnrushaAutoFarmState = table.clone(SavedToggleState) end)
    end
end

local function queueReloadOnTeleport()
    if type(AUTOMATION_SCRIPT_URL) ~= "string"
        or AUTOMATION_SCRIPT_URL == ""
        or AUTOMATION_SCRIPT_URL:find("СЮДА_ВСТАВЬ", 1, true) then
        warn("[Onrusha] Auto Reconnect: set AUTOMATION_SCRIPT_URL to this script's raw URL first")
        return false
    end

    local queue
    for _, env in ipairs(getEnvironments()) do
        queue = env.queue_on_teleport or env.queueonteleport or env.queue_on_tp
        if type(queue) ~= "function" and type(env.syn) == "table" then
            queue = env.syn.queue_on_teleport
        end
        if type(queue) == "function" then break end
    end

    if type(queue) ~= "function" then
        warn("[Onrusha] Auto Reconnect: queue_on_teleport API is unavailable")
        return false
    end

    saveToggleState()
    local queuedCode = string.format([[
local HttpService = game:GetService("HttpService")
local shouldRun = false
if type(isfile) == "function" and type(readfile) == "function" then
    local ok, content = pcall(readfile, %q)
    if ok and type(content) == "string" then
        local decodedOK, state = pcall(function() return HttpService:JSONDecode(content) end)
        shouldRun = decodedOK and type(state) == "table" and state["Auto Reconnect"] == true
    end
end
if not shouldRun and type(getgenv) == "function" then
    local ok, env = pcall(getgenv)
    shouldRun = ok and type(env) == "table" and type(env.OnrushaAutoFarmState) == "table" and env.OnrushaAutoFarmState["Auto Reconnect"] == true
end
if not shouldRun then return end
local u = %q
local ok, src = pcall(function() return game:HttpGet(u) end)
if ok and type(src) == "string" then
    local f = loadstring(src)
    if type(f) == "function" then f() end
end
]], TOGGLE_STATE_FILE, AUTOMATION_SCRIPT_URL)
    local ok, err = pcall(queue, queuedCode)
    if not ok then warn("[Onrusha] Auto Reconnect queue failed:", err) end
    return ok
end

