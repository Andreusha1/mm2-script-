    local parts = {}
    if not coinServer then return parts end
    if coinServer:IsA("BasePart") then
        table.insert(parts, coinServer)
        return parts
    end
    for _, d in ipairs(coinServer:GetDescendants()) do
        if d:IsA("BasePart") then
            table.insert(parts, d)
        end
    end
    return parts
end

local function hasTouchedEvent(coinServer)
    if not coinServer or not coinServer.Parent then return false end
    if coinServer:IsA("BasePart") and coinServer:FindFirstChildOfClass("TouchTransmitter") then
        return true
    end
    for _, d in ipairs(coinServer:GetDescendants()) do
        if d:IsA("BasePart") and d:FindFirstChildOfClass("TouchTransmitter") then
            return true
        end
    end
    return false
end

local function getCoinCenter(coinServer)
    if not coinServer then return nil end
    if coinServer:IsA("BasePart") then return coinServer.Position end
    if coinServer.PrimaryPart then return coinServer.PrimaryPart.Position end
    local parts = getCoinParts(coinServer)
    if #parts == 0 then return nil end
    local sum = Vector3.zero
    for _, p in ipairs(parts) do sum = sum + p.Position end
    return sum / #parts
end

local function isOnCooldown(coinServer)
    local t = COOLDOWN[coinServer]
    if not t then return false end
    if tick() - t >= COOLDOWN_TIME then
        COOLDOWN[coinServer] = nil
        return false
    end
    return true
end

local function findNearestCoin(originPos, radius)
    local best, bestDist = nil, radius
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "Coin_Server"
            and matchesFarmTarget(obj)
            and not isOnCooldown(obj)
            and hasTouchedEvent(obj)
        then
            local center = getCoinCenter(obj)
            if center then
                local dist = (center - originPos).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    best = obj
                end
            end
        end
    end
    return best
end

local function fireTouch(hrp, targetPart)
    pcall(function()
        firetouchinterest(hrp, targetPart, 0)
        task.wait(0.01)
        firetouchinterest(hrp, targetPart, 1)
    end)
end

local function touchCoin(character, coinServer)
    if not character or not coinServer or not coinServer.Parent then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    for _, part in ipairs(getCoinParts(coinServer)) do
        if part.Parent then
            fireTouch(hrp, part)
        end
    end
end

local function anchorCharacter()
    local character = game:GetService("Players").LocalPlayer.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    hrp.Anchored = true
end

local function startFarmLoop()
    local player = game:GetService("Players").LocalPlayer
    if farmThread then task.cancel(farmThread); farmThread = nil end
    table.clear(COOLDOWN)

    farmThread = task.spawn(function()
        local target = nil

        while wig.AutoFarm:Get() do
            if checkInventoryFull() and not hasFullInventory then
                hasFullInventory = true
                executeAfterAction()
                if not wig.AutoFarm:Get() then break end
            end

            local character = player.Character
            local hrp = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")

            if not hrp or not humanoid or humanoid.Health <= 0 then
                target = nil
                task.wait(0.5)
                continue
            end

            if not hrp.Anchored then
                hrp.Anchored = true
            end

            local radius = wig.FarmRadius:Get()
            local center = target and target.Parent and getCoinCenter(target)

            if not center
                or (center - hrp.Position).Magnitude > radius
                or isOnCooldown(target)
                or not hasTouchedEvent(target)
            then
                target = findNearestCoin(hrp.Position, radius)
                if not target then
                    task.wait(0.2)
                    continue
                end
                center = getCoinCenter(target)
                if not center then
                    target = nil
                    task.wait(0.05)
                    continue
                end
            end

            local distance = (center - hrp.Position).Magnitude

            if distance > 2 then
                local speed = wig.FarmSpeed:Get()
                local dir = (center - hrp.Position).Unit
                local step = math.min(speed * 0.03, distance)
                hrp.CFrame = CFrame.new(hrp.Position + dir * step)
                task.wait(0.03)
            else
                hrp.Anchored = false
                hrp.CFrame = CFrame.new(center + Vector3.new(0, 2, 0))
                task.wait(0.05)
                
                local touchStartTime = tick()
                local timeout = wig.FarmTimeout:Get() / 10
                local pickedUp = false

                while wig.AutoFarm:Get() do
                    if not target or not target.Parent then
                        pickedUp = true
                        break
                    end
                    
                    if not hasTouchedEvent(target) then
                        pickedUp = true
                        break
                    end

                    touchCoin(character, target)
                    task.wait(0.1)

                    if tick() - touchStartTime > timeout then
                        break
                    end
                end

                COOLDOWN[target] = tick()
                target = nil
                
                if hrp and hrp.Parent then
                    hrp.Anchored = true
                end
                task.wait(0.1)
            end
        end
    end)
end

wig.AutoFarm:OnChanged(function(value)
    if value then
        hasFullInventory = false
        anchorCharacter()
        if farmAnchorConn then farmAnchorConn:Disconnect() end
        farmAnchorConn = game:GetService("Players").LocalPlayer.CharacterAdded:Connect(function()
