local atmosphere = nil
local blurEffect = nil
local colorCorrection = nil
local sunRays = nil
local depthOfField = nil
local fogOriginal = nil

local function applyFog()
    local lighting = game:GetService("Lighting")
    if not wig.Fog:Get() then
        if fogOriginal then
            lighting.FogStart = fogOriginal.FogStart
            lighting.FogEnd = fogOriginal.FogEnd
            lighting.FogColor = fogOriginal.FogColor
            fogOriginal = nil
        end
        if atmosphere then atmosphere:Destroy(); atmosphere = nil end
        if blurEffect then blurEffect:Destroy(); blurEffect = nil end
        if colorCorrection then colorCorrection:Destroy(); colorCorrection = nil end
        if sunRays then sunRays:Destroy(); sunRays = nil end
        if depthOfField then depthOfField:Destroy(); depthOfField = nil end
        return
    end
    if not fogOriginal then
        fogOriginal = {
            FogStart = lighting.FogStart,
            FogEnd = lighting.FogEnd,
            FogColor = lighting.FogColor
        }
    end
    local presetName = wig.FogPreset:Get()
    local color, density, haze, glare, blur, brightness, tintColor, saturation
    if presetName == "Custom" then
        color = wig.FogColor:Get()
        density = wig.FogDensity:Get() / 100
        haze = wig.FogHaze:Get()
        blur = wig.FogBlur:Get() / 10
        glare = 0
        brightness = 0
        tintColor = color
        saturation = 0
    else
        local preset = FOG_PRESETS[presetName] or FOG_PRESETS["Blue Mist"]
        color = preset.Color
        density = preset.Density / 100
        haze = preset.Haze
        blur = preset.Blur / 10
        glare = preset.Glare / 10
        brightness = preset.Brightness / 100 - 1
        tintColor = preset.TintColor
        saturation = preset.Saturation
    end
    density = math.clamp(density, 0.01, 1)
    haze = math.clamp(haze, 0, 10)
    if not atmosphere or not atmosphere.Parent then
        atmosphere = Instance.new("Atmosphere")
        atmosphere.Name = "CustomFogAtmosphere"
        atmosphere.Parent = lighting
    end
    atmosphere.Color = color
    atmosphere.Decay = color:Lerp(Color3.fromRGB(20, 20, 25), 0.25)
    atmosphere.Density = density
    atmosphere.Haze = haze
    atmosphere.Glare = glare
    atmosphere.Offset = -0.25
    lighting.FogColor = color
    lighting.FogStart = 0
    lighting.FogEnd = math.clamp(900 - density * 850, 60, 850)
    if not blurEffect or not blurEffect.Parent then
        blurEffect = Instance.new("BlurEffect")
        blurEffect.Name = "CustomFogBlur"
        blurEffect.Parent = lighting
    end
    blurEffect.Size = blur
    if not colorCorrection or not colorCorrection.Parent then
        colorCorrection = Instance.new("ColorCorrectionEffect")
        colorCorrection.Name = "CustomFogCC"
        colorCorrection.Parent = lighting
    end
    colorCorrection.TintColor = tintColor
    colorCorrection.Brightness = math.clamp(brightness, -0.3, 0.1)
    colorCorrection.Contrast = 0.08
    colorCorrection.Saturation = saturation
    if not sunRays or not sunRays.Parent then
        sunRays = Instance.new("SunRaysEffect")
        sunRays.Name = "CustomFogRays"
        sunRays.Parent = lighting
    end
    sunRays.Intensity = math.clamp(glare * 0.1, 0, 0.2)
    sunRays.Spread = 0.6
    if not depthOfField or not depthOfField.Parent then
        depthOfField = Instance.new("DepthOfFieldEffect")
        depthOfField.Name = "CustomFogDOF"
        depthOfField.Parent = lighting
    end
    depthOfField.FarIntensity = math.clamp(density * 0.4, 0.05, 0.4)
    depthOfField.FocusDistance = 20
    depthOfField.InFocusRadius = 35
    depthOfField.NearIntensity = 0
end

wig.Fog:OnChanged(applyFog)
wig.FogPreset:OnChanged(function()
    if wig.Fog:Get() then applyFog() end
end)
wig.FogColor:OnChanged(function()
