local function removeESP(player)
    if player.Character then
        local oldHL = player.Character:FindFirstChild("ESP_Highlight")
        if oldHL then oldHL:Destroy() end
        local head = player.Character:FindFirstChild("Head")
        if head then
            local oldTag = head:FindFirstChild("ESP_NameTag")
            if oldTag then oldTag:Destroy() end
        end
    end
end

local function getPlayerRole(player)
    local backpack = player:FindFirstChild("Backpack")
    if (backpack and backpack:FindFirstChild("Knife")) or (player.Character and player.Character:FindFirstChild("Knife")) then
        return "Murder"
    elseif (backpack and backpack:FindFirstChild("Gun")) or (player.Character and player.Character:FindFirstChild("Gun")) then
        return "Sheriff"
    end
    return "Player"
end

local function shouldShowPlayer(player)
    local filter = wig.FilterMode:Get()
    if filter == "All" then return true end
    local role = getPlayerRole(player)
    if filter == "Murder Only" and role == "Murder" then return true
    elseif filter == "Sheriff Only" and role == "Sheriff" then return true
    elseif filter == "Murder & Sheriff" and (role == "Murder" or role == "Sheriff") then return true end
    return false
end

local function getESPColor(player)
    local role = getPlayerRole(player)
    if role == "Murder" then return wig.MurderColor:Get()
    elseif role == "Sheriff" then return wig.SheriffColor:Get() end
    return wig.PlayerColor:Get()
end

local function applyESP(player)
    if player == game:GetService("Players").LocalPlayer then return end
    if not wig.ESP:Get() then return end
    if not shouldShowPlayer(player) then 
        removeESP(player)
        return 
    end

    local character = player.Character
    if not character then return end
    
    local head = character:FindFirstChild("Head")
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not head or not hrp then return end

    local color = getESPColor(player)

    local HL = character:FindFirstChild("ESP_Highlight")
    if not HL then
        HL = Instance.new("Highlight")
        HL.Name = "ESP_Highlight"
        HL.OutlineColor = Color3.fromRGB(255, 255, 255)
        HL.FillTransparency = 0.5
        HL.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        HL.Parent = character
    end
    HL.FillColor = color

    local billboard = head:FindFirstChild("ESP_NameTag")
    if not billboard then
        billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_NameTag"
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = head

        local textLabel = Instance.new("TextLabel")
        textLabel.Name = "ESP_NameLabel"
        textLabel.Size = UDim2.new(1, 0, 1, 0)
        textLabel.BackgroundTransparency = 1
        textLabel.TextSize = 14
        textLabel.Font = Enum.Font.SourceSansBold
        textLabel.TextStrokeTransparency = 0
        textLabel.Parent = billboard
    end
    
    local textLabel = billboard:FindFirstChild("ESP_NameLabel")
    if textLabel then
        textLabel.Text = player.DisplayName
        textLabel.TextColor3 = color
    end
end

local function refreshAllESP()
    for _, player in pairs(game:GetService("Players"):GetPlayers()) do
        if wig.ESP:Get() then applyESP(player) else removeESP(player) end
    end
end

