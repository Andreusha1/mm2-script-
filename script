    local function hookBackpack(backpack)
        table.insert(espConnections, backpack.ChildAdded:Connect(function()
            if wig.ESP:Get() then applyESP(player) end
        end))
        table.insert(espConnections, backpack.ChildRemoved:Connect(function()
            if wig.ESP:Get() then applyESP(player) end
        end))
    end

    if player:FindFirstChild("Backpack") then
        hookBackpack(player.Backpack)
    end
    table.insert(espConnections, player.ChildAdded:Connect(function(child)
        if child.Name == "Backpack" then hookBackpack(child) end
    end))
end

wig.ESP:OnChanged(function(value)
    if value then
        for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
            watchESPPlayer(player)
        end
        table.insert(espConnections, game:GetService("Players").PlayerAdded:Connect(watchESPPlayer))

        if espCheckThread then task.cancel(espCheckThread) end
        espCheckThread = task.spawn(function()
            while wig.ESP:Get() do
                task.wait(0.5)
                refreshAllESP()
            end
        end)
    else
        for _, conn in ipairs(espConnections) do 
            if conn then conn:Disconnect() end 
        end
        table.clear(espConnections)
        if espCheckThread then 
            task.cancel(espCheckThread) 
            espCheckThread = nil 
        end
        for _, player in ipairs(game:GetService("Players"):GetPlayers()) do 
            removeESP(player) 
        end
    end
end)

