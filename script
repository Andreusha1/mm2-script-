local lastJumpTime = 0

local function getLocalHumanoid()
    local char = game:GetService("Players").LocalPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function hookBunnyHop(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not humanoid then return end

    bunnySpeed = 16
    lastJumpTime = tick()

    local wasAirborne = false

    table.insert(bunnyConnections, humanoid.StateChanged:Connect(function(_, newState)
        if not wig.BunnyHop:Get() then return end

        if newState == Enum.HumanoidStateType.Jumping or newState == Enum.HumanoidStateType.Freefall then
            wasAirborne = true
        elseif newState == Enum.HumanoidStateType.Landed or newState == Enum.HumanoidStateType.Running then
            if wasAirborne then
                wasAirborne = false
                bunnySpeed = math.min(bunnySpeed + wig.BunnySpeedBoost:Get(), wig.BunnyMaxSpeed:Get())
                humanoid.WalkSpeed = bunnySpeed
                lastJumpTime = tick()
            end
        end
    end))
end

table.insert(bunnyConnections, game:GetService("RunService").Heartbeat:Connect(function()
    if not wig.BunnyHop:Get() then return end

    local humanoid = getLocalHumanoid()
    if not humanoid then return end

    local moveDir = humanoid.MoveDirection
    
    if moveDir.Magnitude < 0.1 then
        bunnySpeed = 16
        humanoid.WalkSpeed = 16
    else
        if tick() - lastJumpTime > 0.8 then
            bunnySpeed = 16
            humanoid.WalkSpeed = 16
        else
            if humanoid.WalkSpeed < bunnySpeed then
                humanoid.WalkSpeed = bunnySpeed
            end
        end
    end
end))

