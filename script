    else
        for _, conn in ipairs(bunnyConnections) do
            if conn and conn.Disconnect then conn:Disconnect() end
        end
        table.clear(bunnyConnections)
        
        local humanoid = getLocalHumanoid()
        if humanoid then
            humanoid.WalkSpeed = 16
        end
        bunnySpeed = 16
    end
end)

