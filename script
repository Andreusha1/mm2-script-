local function startRainbow()
    if rainbowThread then task.cancel(rainbowThread); rainbowThread = nil end
    if not wig.Trails:Get() then return end
    if wig.TrailPreset:Get() ~= "Rainbow" then return end

    rainbowThread = task.spawn(function()
        local hue = 0
        while wig.Trails:Get() and wig.TrailPreset:Get() == "Rainbow" do
            hue = (hue + 0.01) % 1
            local color = Color3.fromHSV(hue, 1, 1)
            for _, data in pairs(activeTrails) do
                local trail = data[1]
                if trail and trail.Parent then
                    trail.Color = ColorSequence.new(color)
                end
            end
            task.wait(0.05)
        end
    end)
end

