local function teleportToGun(gunModel)
    if not isLocalPlayerAlive() then return end
    if isLocalPlayerMurderer() then return end

    local player = game:GetService("Players").LocalPlayer
    local character = player.Character
    if not character then return end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid or humanoid.Health <= 0 then return end

    local targetPart = gunModel
    if gunModel:IsA("Model") then
        targetPart = gunModel.PrimaryPart or gunModel:FindFirstChildWhichIsA("BasePart")
    end

    if not targetPart or not targetPart:IsA("BasePart") then return end

    local originalCFrame = hrp.CFrame

    hrp.Anchored = false
    hrp.CFrame = CFrame.new(targetPart.Position + Vector3.new(0, 3, 0))
    task.wait(0.2)

    for _, part in ipairs(gunModel:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function()
                firetouchinterest(hrp, part, 0)
                task.wait(0.01)
                firetouchinterest(hrp, part, 1)
            end)
        end
    end
    
    task.wait(0.3)

    if wig.AutoGunReturn:Get() and hrp and hrp.Parent then
        hrp.CFrame = originalCFrame
    end
end

