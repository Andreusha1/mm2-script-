    Default = 0,
})

local antiAFKThread = nil
local antiAFKGeneration = 0
local antiAFKIdledConnection = nil

local function performAntiAFKAction()
    local character = AntiAFKPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if not humanoid or humanoid.Health <= 0 or not root then
        return
    end

    local action = wig.AntiAFKAction:Get()

    if action == "Jump" or action == "Jump + Walk" then
        humanoid.Jump = true
        pcall(function()
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end)
    end

    if action == "Walk" or action == "Jump + Walk" then
        local direction = math.random(0, 1) == 0 and -1 or 1
        local moveDirection = root.CFrame.RightVector * direction
        moveDirection = Vector3.new(moveDirection.X, 0, moveDirection.Z)

        if moveDirection.Magnitude > 0 then
            humanoid:Move(moveDirection.Unit, false)
            local stopAt = os.clock() + 0.65
            while os.clock() < stopAt and humanoid.Parent and humanoid.Health > 0 do
                task.wait(0.05)
            end
            if humanoid.Parent then
                humanoid:Move(Vector3.zero, false)
            end
        end
    elseif action == "Turn" then
        root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(45), 0)
    end
end

wig.AntiAFK:OnChanged(function(enabled)
    antiAFKGeneration += 1
    local generation = antiAFKGeneration

    if antiAFKThread then
        pcall(task.cancel, antiAFKThread)
        antiAFKThread = nil
    end

    if antiAFKIdledConnection then
        antiAFKIdledConnection:Disconnect()
        antiAFKIdledConnection = nil
    end

    if not enabled then
        return
    end

    pcall(function()
        antiAFKIdledConnection = AntiAFKPlayer.Idled:Connect(function()
            if not wig.AntiAFK:Get() then
                return
            end
            pcall(function()
                AntiAFKVirtualUser:CaptureController()
                AntiAFKVirtualUser:ClickButton2(Vector2.new(0, 0))
            end)
        end)
    end)

    antiAFKThread = task.spawn(function()
        while wig.AntiAFK:Get() and generation == antiAFKGeneration do
            pcall(performAntiAFKAction)

            local minutes = tonumber(wig.AntiAFKMinutes:Get()) or 5
            local seconds = tonumber(wig.AntiAFKSeconds:Get()) or 0
            local interval = math.max(1, minutes * 60 + seconds)
            local elapsed = 0

            while elapsed < interval
                and wig.AntiAFK:Get()
                and generation == antiAFKGeneration do
                local step = math.min(0.25, interval - elapsed)
                task.wait(step)
                elapsed += step
            end
        end

        if generation == antiAFKGeneration then
            antiAFKThread = nil
        end
    end)
end)

