local function spawnJumpCircle(character)
    if not wig.JumpCircles:Get() then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local presetName = wig.JumpPreset:Get()
    local preset = JUMP_PRESETS[presetName] or JUMP_PRESETS["Ice Ring"]

    local sizeMulti = wig.JumpSize:Get() / 10
    local lifetime = wig.JumpLifetime:Get() / 100

    local startSize = preset.StartSize * sizeMulti
    local endSize = preset.EndSize * sizeMulti

    local color = preset.Color
    if preset.rainbow then
        color = Color3.fromHSV(math.random(), 1, 1)
    end

    local part = Instance.new("Part")
    part.Name = "JumpCircleFX"
    part.Shape = Enum.PartType.Block
    part.Material = Enum.Material.SmoothPlastic
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Transparency = 1
    part.Size = Vector3.new(startSize, 0.1, startSize)
    part.CFrame = CFrame.new(hrp.Position - Vector3.new(0, 3, 0))
    part.Parent = workspace

    local decal = Instance.new("Decal")
    decal.Texture = preset.Texture
    decal.Face = Enum.NormalId.Top
    decal.Color3 = color
    decal.Transparency = 0
    decal.Parent = part

    local tweenService = game:GetService("TweenService")
    local sizeTween = tweenService:Create(part, TweenInfo.new(lifetime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = Vector3.new(endSize, 0.1, endSize),
    })
    local fadeTween = tweenService:Create(decal, TweenInfo.new(lifetime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Transparency = 1,
    })

    sizeTween:Play()
    fadeTween:Play()

    table.insert(jumpCircles, part)

    task.delay(lifetime + 0.1, function()
        if part and part.Parent then part:Destroy() end
        for i, v in ipairs(jumpCircles) do
            if v == part then table.remove(jumpCircles, i) break end
        end
    end)
end

local function hookCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not humanoid then return end

    local wasAirborne = false

    table.insert(jumpConnections, humanoid.StateChanged:Connect(function(_, newState)
        if not wig.JumpCircles:Get() then return end

        if newState == Enum.HumanoidStateType.Jumping or newState == Enum.HumanoidStateType.Freefall then
            wasAirborne = true
        elseif newState == Enum.HumanoidStateType.Landed or newState == Enum.HumanoidStateType.Running then
            if wasAirborne then
                wasAirborne = false
                spawnJumpCircle(character)
            end
        elseif newState == Enum.HumanoidStateType.Dead then
            wasAirborne = false
        end
    end))
end

local function watchJumpPlayer(player)
    if player.Character then
        task.spawn(hookCharacter, player.Character)
    end
    table.insert(jumpConnections, player.CharacterAdded:Connect(function(character)
        task.wait(0.5)
        if wig.JumpCircles:Get() then
            hookCharacter(character)
        end
    end))
end

wig.JumpCircles:OnChanged(function(value)
    if value then
        for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
            watchJumpPlayer(player)
        end
        table.insert(jumpConnections, game:GetService("Players").PlayerAdded:Connect(watchJumpPlayer))
    else
        for _, conn in ipairs(jumpConnections) do
            if conn and conn.Disconnect then conn:Disconnect() end
        end
        table.clear(jumpConnections)
        for _, part in ipairs(jumpCircles) do
            if part and part.Parent then part:Destroy() end
        end
        table.clear(jumpCircles)
    end
end)

