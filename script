local killSettings = wig.AutoKillInnocents:CreateSettings({ Name = "Settings" })

wig.KillTargetMode = killSettings:DropdownCreate({
    Id = "AutoKillInnocents.TargetMode",
    Name = "Target Mode",
    Options = { "Closest", "Sheriff First", "Random" },
    Default = "Closest",
})

wig.KillDistance = killSettings:SliderCreate({
    Id = "AutoKillInnocents.Distance",
    Name = "Teleport Distance",
    Min = 1,
    Max = 10,
    Default = 1,
})

local killThread = nil

local function isAlive(player)
    local alive = player:GetAttribute("Alive")
    if alive == false then return false end
    
    local char = player.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end
    
    return true
end

local function isMurderer()
    local player = game:GetService("Players").LocalPlayer
    local backpack = player:FindFirstChild("Backpack")
    local char = player.Character
    return (backpack and backpack:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife"))
end

local function getTargets()
    local player = game:GetService("Players").LocalPlayer
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end

    local targets = {}
    for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
        if p ~= player and p.Character and isAlive(p) then
            local backpack = p:FindFirstChild("Backpack")
            local char = p.Character
            local hasKnife = (backpack and backpack:FindFirstChild("Knife")) or (char and char:FindFirstChild("Knife"))
            
            if not hasKnife then
                local mHrp = char:FindFirstChild("HumanoidRootPart")
                local mHumanoid = char:FindFirstChildOfClass("Humanoid")
                if mHrp and mHumanoid and mHumanoid.Health > 0 then
                    local hasGun = (backpack and backpack:FindFirstChild("Gun")) or (char and char:FindFirstChild("Gun"))
                    local dist = (mHrp.Position - hrp.Position).Magnitude
                    table.insert(targets, {
                        Player = p,
                        Hrp = mHrp,
                        Humanoid = mHumanoid,
                        Distance = dist,
                        IsSheriff = hasGun
                    })
                end
            end
        end
    end
    return targets
end

local function getBestTarget(targets)
    if #targets == 0 then return nil end
    local mode = wig.KillTargetMode:Get()

    if mode == "Sheriff First" then
        for _, t in ipairs(targets) do
            if t.IsSheriff then return t end
        end
    end

    if mode == "Random" then
        return targets[math.random(1, #targets)]
    end

    local best = targets[1]
    for _, t in ipairs(targets) do
        if t.Distance < best.Distance then
            best = t
        end
    end
    return best
end

local function getKnife()
    local player = game:GetService("Players").LocalPlayer
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    if not char or not backpack then return nil end
    local knife = char:FindFirstChild("Knife")
    if knife then return knife end
    local bk = backpack:FindFirstChild("Knife")
    if bk then
        bk.Parent = char
        return bk
    end
    return nil
end

local function attackTarget(target)
    local player = game:GetService("Players").LocalPlayer
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp or not target.Hrp or not target.Humanoid or target.Humanoid.Health <= 0 then return end

    hrp.Anchored = true

    local dir = (target.Hrp.Position - hrp.Position).Unit
    local dist = wig.KillDistance:Get()
    
    hrp.CFrame = CFrame.lookAt(target.Hrp.Position - dir * dist + Vector3.new(0, 1, 0), target.Hrp.Position)

    task.wait()

    local knife = getKnife()
    if knife then
        local handle = knife:FindFirstChild("Handle")
        if handle then
            pcall(function()
                firetouchinterest(handle, target.Hrp, 0)
                task.wait(0.01)
                firetouchinterest(handle, target.Hrp, 1)
            end)
        end
        pcall(function() knife:Activate() end)
    end

    hrp.Anchored = false
end

local function startAutoKill()
    local player = game:GetService("Players").LocalPlayer
    if killThread then task.cancel(killThread) end
    killThread = task.spawn(function()
        while wig.AutoKillInnocents:Get() do
            local char = player.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            
            if char and humanoid and humanoid.Health > 0 and isAlive(player) and isMurderer() then
                local targets = getTargets()
                local target = getBestTarget(targets)
                if target then
                    attackTarget(target)
                end
            end
            task.wait(0.05)
        end
    end)
end

local function stopAutoKill()
    if killThread then
        task.cancel(killThread)
        killThread = nil
    end
    local char = game:GetService("Players").LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.Anchored = false end
    end
end

wig.AutoKillInnocents:OnChanged(function(value)
    if value then
        if not isMurderer() then
            ui:Notify({ Title = "Auto Kill", Description = "You are not the Murderer!", Type = "Error", Duration = 3 })
            wig.AutoKillInnocents:Set(false)
            return
        end
        startAutoKill()
        ui:Notify({ Title = "Auto Kill", Description = "Hunting Innocents...", Type = "Success", Duration = 3 })
    else
        stopAutoKill()
    end
end)

